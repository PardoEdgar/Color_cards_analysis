import subprocess
import os
from pathlib import Path
from concurrent.futures import ProcessPoolExecutor, as_completed
import tkinter as tk
from tkinter import filedialog
from tqdm import tqdm

# Possible dimensions. Not used in this script actually. Will move to a different script later.
# CR2_DIMENSIONS = [3360, 6720]

# Path for DNG converter app
DNG_CONVERTER_PATH = r'C:\Program Files\Adobe\Adobe DNG Converter\Adobe DNG Converter.exe'
INITIAL_DIR1 = 'E:/Photos/RRR_project'
INITIAL_DIR2 = 'E:/'
SECTION_NAMES = ['0to25', '25to50']

# Custom exceptions.
class NoDirectorySelected(Exception):
    pass

class NoPhotoFiles(Exception):
    pass

class NamingConventionError(Exception):
    pass

class DNGMismatchError(Exception):
    pass

class FileOrganizationError(Exception):
    pass

class MissingFarawayName(Exception):
    pass

def choose_directory(title: str, initialdir: str):
    root = tk.Tk()

    root.withdraw()
    folder = filedialog.askdirectory(title = title, initialdir = initialdir)
    root.destroy()

    if not folder:
        raise NoDirectorySelected('No directory was selected.')
    return folder

# Input path includes the file name.
# Output directory is the directory where the file will be stored, no file name.
# Code by Edgar.
def convert_CR2_to_DNG(input_path: Path, output_dir: Path):
    cmd = [DNG_CONVERTER_PATH, '-p1', '-d', str(output_dir), str(input_path)]

    try:
        result = subprocess.run(cmd, stdout = subprocess.PIPE, stderr = subprocess.PIPE, timeout = 300, text = True)
    except subprocess.TimeoutExpired:
        return 'ERROR', f'{input_path.name}: conversion timed out'
    except Exception as e:
        return 'ERROR', f'{input_path.name}: {e}'
    
    if result.returncode != 0:
        error_message = result.stderr.strip()
        return 'ERROR', f'{input_path.name}: {error_message}'

    return 'OK', input_path.name

def convert_directory_CR2_to_DNG(input_dir: Path, output_dir: Path, max_workers = 12):
    output_dir.mkdir(parents = True, exist_ok = True)

    # Only select CR2 files. This should've been quality checked at some point.
    CR2_paths = [photo_path for photo_path in input_dir.iterdir() if photo_path.suffix.lower() == '.cr2']

    if len(CR2_paths) == 0:
        raise NoPhotoFiles(f'No CR2 files found in {input_dir}')

    max_workers = max(1, min(os.cpu_count() - 2, max_workers))

    with ProcessPoolExecutor(max_workers = max_workers) as executor:
        futures = {executor.submit(convert_CR2_to_DNG, photo_path, output_dir): photo_path for photo_path in CR2_paths}

        for future in tqdm(as_completed(futures), total = len(futures), desc = f'Converting CR2 files in {input_dir.name} to DNG'):
            status, file_name = future.result()

            if status == 'ERROR':
                tqdm.write(f'{file_name}: {status}')

    print(f'DNGs saved to {output_dir}\n')
        
if __name__ == "__main__":
    # This assumes that the user chooses the folder with 0to25 and 25to50.
    main_dir = Path(choose_directory('Select folder with CR2 images to convert', INITIAL_DIR1))
    main_output_dir = Path(choose_directory('Select output parent directory', INITIAL_DIR2))

    for section in SECTION_NAMES:
        input_dir = main_dir / Path(main_dir.name + '_' + section) / 'CR2'

        if not input_dir.exists():
            raise NamingConventionError(f'Directory {input_dir} should exist. Naming convention violated.')
        elif any(photo_path.suffix.lower() != '.cr2' for photo_path in input_dir.iterdir()):
            raise FileOrganizationError(f'Directory {input_dir} should only contain CR2 files. File organization violated.')

        # By convention, there should be a Photos subdirectory somewhere in the input directory.
        if 'Photos' not in input_dir.parts or 'CR2' not in input_dir.parts:
            raise NamingConventionError('Naming convention error. Photos should be within a Photos subdirectory and a CR2 directory.')
        
        input_dir_parts = list(input_dir.parts)
        input_dir_parts[input_dir.parts.index('CR2')] = 'DNG'
        idx = input_dir_parts.index('Photos') + 1
        input_dir_structure = Path(*input_dir_parts[idx:])

        output_dir = main_output_dir / input_dir_structure
        output_dir.mkdir(parents = True, exist_ok = True)

        # Copying text file with faraway photo name.
        text_path = main_dir / Path(main_dir.name + '_' + section) / Path('faraway_image.txt')
        text_target_path = output_dir.parent / Path('faraway_image.txt')

        if not text_path.exists():
            raise MissingFarawayName('The faraway name text file is missing. Make sure to generate the metadata for the original photo set first.')

        text_path.copy(text_target_path, preserve_metadata = True)   

        # Main function calls.
        convert_directory_CR2_to_DNG(input_dir, output_dir)             

        # Checking number of files.
        input_files = [photo_path for photo_path in input_dir.iterdir()]
        output_files = [photo_path for photo_path in output_dir.iterdir()]

        if len(input_files) != len(output_files):
            raise DNGMismatchError(f'The number of CR2 files is {len(input_files)} and the number of DNG files is {len(output_files)}. There is a size mismatch.')
